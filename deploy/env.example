# Copy to a2a/.env (next to server.py) and fill in.
# Do not put this file on OneDrive as the live secrets file if you can avoid it.

# Bind. 127.0.0.1 = this machine only. 0.0.0.0 = LAN / public (needed to deploy).
A2A_HOST=0.0.0.0
A2A_PORT=8787

# The URL other AIs will fetch. HTTPS once a domain is on.
# Example home: http://192.168.1.20:8787
# Live (no bought domain): https://170.64.146.185.sslip.io
A2A_PUBLIC_URL=https://170.64.146.185.sslip.io

# Public buyer/operator GEO on the agent card and llms.txt.
# Name and city default to Paul Salviani, Sydney (Codex brief). Email stays off until set.
# Do not invent an email, company, phone, or ACN.
# A2A_OPERATOR_NAME=Paul Salviani
# A2A_OPERATOR_LOCATION=Sydney
# A2A_OPERATOR_EMAIL=

# Operator write key. Generate with: python deploy/new_write_key.py
# Store the hash only in sqlite. If you lose this string, rotate.
A2A_WRITE_KEY=replace-me

# The log is the company. Keep it OFF OneDrive. WAL + cloud sync corrupts sqlite.
# Windows second PC: C:\a2a-data\a2a.sqlite
# Linux VPS: /var/lib/a2a/a2a.sqlite
A2A_DB=C:\a2a-data\a2a.sqlite
